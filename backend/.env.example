# ============================================================
# DialDesk Invoice Automation — Backend environment variables
# Copy this file to ".env" and fill in your values.
# ============================================================

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# DialDesk CRM credentials (used to fetch clients live)
CRM_EMAIL=ispark@dialdesk.in
CRM_PASSWORD=1234

# Secret used to encrypt SMTP passwords at rest (any random string).
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-long-random-string

# CRM base URL (rarely needs changing)
CRM_BASE_URL=https://crmapi.dialdesk.in

# Supabase Storage bucket name
STORAGE_BUCKET=invoices

# Allowed CORS origin for the frontend (Vite default)
FRONTEND_ORIGIN=http://localhost:5173
